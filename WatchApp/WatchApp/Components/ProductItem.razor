
<div class="col-sm-4 p-2">
    <div class="card">
        <div class="d-flex justify-content-center p-2">
            <img src="@Product.ImageUrl" height="200" alt="..." />
        </div>
        <div class="card-body">
            <h5 class="card-title">  
                <a href="/product/@Product.Id"> @Product.Name </a>
            </h5>
            <p class="card-text">@Product.Description.Substring(0, Math.Min(50, Product.Description.Length))</p>
            <p class="text-secondary text-center h2 font-weight-bold">@Product.Price.ToString("C")</p>
            <a href="#" class="btn btn-danger w-100"><i class="fas fa-shopping-cart"></i> Add To Cart</a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Product Product { get;set; }

    
}
