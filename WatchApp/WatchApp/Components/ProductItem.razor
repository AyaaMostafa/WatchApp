<div class="col-sm-4 p-2">
    <div class="card">
        <div class="d-flex justify-content-center p-2">
            <img src="@ImageUrl" height="200" alt="..." />
        </div>
        <div class="card-body">
            <h5 class="card-title">@Name</h5>
            <p class="card-text">@Description.Substring(0, Math.Min(50, Description.Length))</p>
            <p class="text-secondary text-center h2 font-weight-bold">@Price.ToString("C")</p>
            <a href="#" class="btn btn-danger w-100"><i class="fas fa-shopping-cart"></i> Add To Cart</a>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string ImageUrl { get; set; }
    [Parameter]
    public string Name { get; set; }
    [Parameter]
    public string Description { get; set; }
    [Parameter]
    public decimal Price { get; set; }
}
